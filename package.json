{
  "name": "uit-career-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 run",
    "build:frontend": "pnpm --dir frontend build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 build",
    "build": "pnpm build:frontend && pnpm build:backend",
    "typecheck": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 compile",
    "test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 test",
    "test": "pnpm --dir frontend test && pnpm test:backend",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 db:migrate",
    "db:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 db:seed",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 db:setup",
    "db:demo:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 db:demo:reset",
    "db:e2e:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-backend.ps1 db:e2e:reset",
    "smoke:offer-flow": "node scripts/smoke-offer-flow.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:full": "playwright test --grep @full",
    "e2e:report": "playwright show-report playwright-report",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^17.4.2"
  }
}
