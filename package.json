{
  "name": "uit-career-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --dir backend typecheck",
    "test": "pnpm -r --if-present test",
    "openapi:validate": "pnpm --dir backend openapi:validate",
    "security:production:check": "pnpm --dir backend security:production:check",
    "db:migrate": "pnpm --dir backend db:migrate",
    "db:seed": "pnpm --dir backend db:seed",
    "db:demo:reset": "pnpm --dir backend db:demo:reset",
    "db:demo:check": "pnpm --dir backend db:demo:check",
    "db:e2e:provision": "pnpm --dir backend db:e2e:provision",
    "db:e2e:reset": "pnpm --dir backend db:e2e:reset",
    "db:backup:restore:drill": "pnpm --dir backend db:backup:restore:drill",
    "db:e2e:setup": "pnpm db:e2e:provision && pnpm db:e2e:reset",
    "smoke:offer-flow": "node scripts/smoke-offer-flow.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:full": "playwright test --grep @full",
    "e2e:report": "playwright show-report playwright-report",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^17.4.2"
  }
}
