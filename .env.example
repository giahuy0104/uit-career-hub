NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự; bắt buộc thay ở production.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ISSUER=uit-career-hub-api
JWT_AUDIENCE=uit-career-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_NAME=uit_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
UIT_EMAIL_DOMAINS=student.uit.edu.vn,uit.edu.vn

# Neon: thay bằng pooled connection string ở nút Connect.
DATABASE_URL=postgresql://neondb_owner:replace_me@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# Neon: direct connection dùng riêng cho migration/seed.
DATABASE_URL_DIRECT=

# Branch/database test riêng; để trống thì integration test database được skip.
DATABASE_URL_TEST=

# Chỉ dùng khi chọn PostgreSQL local bằng Docker (tùy chọn).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uit_career_hub
POSTGRES_USER=uit_user
POSTGRES_PASSWORD=uit_local_password
