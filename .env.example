NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự; bắt buộc thay ở production.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ISSUER=uit-career-hub-api
JWT_AUDIENCE=uit-career-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_NAME=uit_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
UIT_EMAIL_DOMAINS=student.uit.edu.vn,uit.edu.vn

# Chỉ bật tạm thời khi cần đưa các định danh demo cố định về checkpoint ban đầu.
ALLOW_DEMO_RESET=false

# Secret tối thiểu 32 ký tự để Vercel Cron gọi endpoint tổng hợp hằng ngày.
CRON_SECRET=replace_with_a_random_cron_secret_at_least_32_characters

# Email transactional qua Resend. Giữ false cho đến khi đã cấu hình API key và sender.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="UIT Career Hub <notifications@your-verified-domain.example>"
PUBLIC_APP_URL=http://localhost:5173
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5

# Cloudflare R2 private bucket. Never expose these values to the frontend.
OBJECT_STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uit-career-hub-documents
OBJECT_UPLOAD_URL_TTL_SECONDS=600
OBJECT_DOWNLOAD_URL_TTL_SECONDS=300

# Neon: thay bằng pooled connection string ở nút Connect.
DATABASE_URL=postgresql://neondb_owner:replace_me@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_POOL_MAX=10

# Neon: direct connection dùng riêng cho migration/seed.
DATABASE_URL_DIRECT=

# Branch/database test riêng; để trống thì integration test database được skip.
DATABASE_URL_TEST=

# Chỉ dùng khi chọn PostgreSQL local bằng Docker (tùy chọn).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uit_career_hub
POSTGRES_USER=uit_user
POSTGRES_PASSWORD=uit_local_password
